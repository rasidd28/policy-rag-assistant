# .gitignore — Policy RAG Assistant
# ────────────────────────────────────────────────────────────────────────────────

# Secrets — NEVER commit these
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
.Python
build/
dist/
*.egg-info/
.eggs/

# Virtual environments
venv/
.venv/
env/
ENV/

# Data / index (can be regenerated)
data/vectordb/
*.db

# Logs
logs/*.jsonl
logs/*.log

# Test / coverage
.pytest_cache/
htmlcov/
.coverage
coverage.xml

# IDE
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db

# Docker
*.tar

# Scratch / temporary
scratch/
